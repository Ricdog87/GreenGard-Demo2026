# Green-Gard — Environment-Variablen
# Kopieren nach .env.local und ausfüllen. Die Site läuft auch OHNE diese Werte
# (Graceful Fallback: Formulare loggen dann nur in die Console).

# --- Supabase (Auth, Leads, Schulungs-Buchungen) ---
# TODO: Supabase-Projekt anlegen, Werte aus Project Settings → API übernehmen,
# danach RLS-Policies aus supabase/schema.sql aktivieren.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, niemals im Client importieren:
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Shop-Checkout + Zahlungslinks für Schulungen) ---
# TODO: Live-Keys aus dem Stripe-Dashboard, Webhook-Secret für /api/stripe/webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transaktionsmails (Lead-Benachrichtigung, Planung per Mail) ---
# TODO: Resend-Account, verifizierte Absenderdomain green-gard.de.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@green-gard.de
