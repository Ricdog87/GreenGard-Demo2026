# Office-365-/Microsoft-Graph-Anbindung für den Formular-Versand.
#
# Diese Werte kommen von der Green-Gard-IT (Gasser). Sie gehören NICHT ins
# Repository — in Vercel unter Project → Settings → Environment Variables
# eintragen (für Production und Preview). Lokal in eine Datei .env.local
# kopieren (die ist per .gitignore ausgeschlossen).
#
# Ohne diese Variablen fallen die Formulare automatisch auf den mailto-Weg
# zurück (kein Fehler, nur kein Server-Versand).

# App-Registrierung (Entra ID) mit Berechtigung "Mail.Send":
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Optional — sind bereits sinnvoll vorbelegt (nur setzen, wenn abweichend):
# Absender = Shared Mailbox, aus der versendet wird
GRAPH_SENDER=web@green-gard.de
# Empfänger = wohin die Anfragen zugestellt werden
GRAPH_RECIPIENT=info@green-gard.de
